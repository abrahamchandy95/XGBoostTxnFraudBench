USE GRAPH TF_GNN

CREATE OR REPLACE QUERY projection_weight_histogram(
    INT probe_a = 2,
    INT probe_b = 4,
    INT probe_c = 6,
    INT probe_d = 20,
    INT probe_e = 10
) FOR GRAPH TF_GNN SYNTAX V2 {

  SumAccum<INT> @da, @db, @dc, @dd, @de;

  MapAccum<INT, SumAccum<INT>> @@cc_bands, @@mm_bands;
  SumAccum<DOUBLE> @@cc_edges, @@mm_edges;
  MaxAccum<INT>    @@cc_max_weight, @@mm_max_weight;
  MinAccum<INT>    @@cc_min_weight, @@mm_min_weight;
  AvgAccum         @@cc_avg_weight, @@mm_avg_weight;

  MapAccum<INT, SumAccum<DOUBLE>> @@cc_surviving, @@mm_surviving;
  MapAccum<INT, SumAccum<INT>>    @@cc_connected, @@mm_connected;

  SumAccum<INT> @@cards_seen, @@merchants_seen;

  cc = SELECT s
       FROM Card:s -(Card_Card:e)- Card:t
       WHERE getvid(s) < getvid(t)
       ACCUM
         INT w = e.weight,
         @@cc_edges += 1,
         @@cc_max_weight += w,
         @@cc_min_weight += w,
         @@cc_avg_weight += w,

         INT band = 9,
         IF w == 1 THEN band = 1
         ELSE IF w == 2 THEN band = 2
         ELSE IF w == 3 THEN band = 3
         ELSE IF w <= 5 THEN band = 4
         ELSE IF w <= 10 THEN band = 5
         ELSE IF w <= 20 THEN band = 6
         ELSE IF w <= 50 THEN band = 7
         ELSE IF w <= 100 THEN band = 8
         END,
         @@cc_bands += (band -> 1),

         IF w >= probe_a AND probe_a != probe_e THEN
             @@cc_surviving += (probe_a -> 1), s.@da += 1, t.@da += 1 END,
         IF w >= probe_b AND probe_b != probe_e AND probe_b != probe_a THEN
             @@cc_surviving += (probe_b -> 1), s.@db += 1, t.@db += 1 END,
         IF w >= probe_c AND probe_c != probe_e AND probe_c != probe_a
                         AND probe_c != probe_b THEN
             @@cc_surviving += (probe_c -> 1), s.@dc += 1, t.@dc += 1 END,
         IF w >= probe_d AND probe_d != probe_e AND probe_d != probe_a
                         AND probe_d != probe_b AND probe_d != probe_c THEN
             @@cc_surviving += (probe_d -> 1), s.@dd += 1, t.@dd += 1 END,
         IF w >= probe_e THEN
             @@cc_surviving += (probe_e -> 1), s.@de += 1, t.@de += 1 END;

  card_degrees = SELECT c FROM Card:c WHERE c.seen == TRUE
      POST-ACCUM
        @@cards_seen += 1,
        IF c.@da > 0 THEN @@cc_connected += (probe_a -> 1) END,
        IF c.@db > 0 THEN @@cc_connected += (probe_b -> 1) END,
        IF c.@dc > 0 THEN @@cc_connected += (probe_c -> 1) END,
        IF c.@dd > 0 THEN @@cc_connected += (probe_d -> 1) END,
        IF c.@de > 0 THEN @@cc_connected += (probe_e -> 1) END;

  /* ---------- Merchant_Merchant ---------- */
  mm = SELECT s
       FROM Merchant:s -(Merchant_Merchant:e)- Merchant:t
       WHERE getvid(s) < getvid(t)
       ACCUM
         INT w = e.weight,
         @@mm_edges += 1,
         @@mm_max_weight += w,
         @@mm_min_weight += w,
         @@mm_avg_weight += w,

         INT band = 9,
         IF w == 1 THEN band = 1
         ELSE IF w == 2 THEN band = 2
         ELSE IF w == 3 THEN band = 3
         ELSE IF w <= 5 THEN band = 4
         ELSE IF w <= 10 THEN band = 5
         ELSE IF w <= 20 THEN band = 6
         ELSE IF w <= 50 THEN band = 7
         ELSE IF w <= 100 THEN band = 8
         END,
         @@mm_bands += (band -> 1),

         IF w >= probe_a AND probe_a != probe_e THEN
             @@mm_surviving += (probe_a -> 1), s.@da += 1, t.@da += 1 END,
         IF w >= probe_b AND probe_b != probe_e AND probe_b != probe_a THEN
             @@mm_surviving += (probe_b -> 1), s.@db += 1, t.@db += 1 END,
         IF w >= probe_c AND probe_c != probe_e AND probe_c != probe_a
                         AND probe_c != probe_b THEN
             @@mm_surviving += (probe_c -> 1), s.@dc += 1, t.@dc += 1 END,
         IF w >= probe_d AND probe_d != probe_e AND probe_d != probe_a
                         AND probe_d != probe_b AND probe_d != probe_c THEN
             @@mm_surviving += (probe_d -> 1), s.@dd += 1, t.@dd += 1 END,
         IF w >= probe_e THEN
             @@mm_surviving += (probe_e -> 1), s.@de += 1, t.@de += 1 END;

  merchant_degrees = SELECT m FROM Merchant:m WHERE m.seen == TRUE
      POST-ACCUM
        @@merchants_seen += 1,
        IF m.@da > 0 THEN @@mm_connected += (probe_a -> 1) END,
        IF m.@db > 0 THEN @@mm_connected += (probe_b -> 1) END,
        IF m.@dc > 0 THEN @@mm_connected += (probe_c -> 1) END,
        IF m.@dd > 0 THEN @@mm_connected += (probe_d -> 1) END,
        IF m.@de > 0 THEN @@mm_connected += (probe_e -> 1) END;

  PRINT @@cc_edges       AS card_card_edges,
        @@cc_min_weight  AS card_card_min_weight,
        @@cc_max_weight  AS card_card_max_weight,
        @@cc_avg_weight  AS card_card_avg_weight,
        @@cards_seen     AS cards_seen;

  PRINT @@mm_edges       AS merchant_merchant_edges,
        @@mm_min_weight  AS merchant_merchant_min_weight,
        @@mm_max_weight  AS merchant_merchant_max_weight,
        @@mm_avg_weight  AS merchant_merchant_avg_weight,
        @@merchants_seen AS merchants_seen;

  PRINT @@cc_bands AS card_card_weight_bands,
        @@mm_bands AS merchant_merchant_weight_bands;

  PRINT @@cc_surviving  AS card_card_surviving_edges_by_threshold,
        @@cc_connected  AS cards_with_degree_by_threshold,
        @@mm_surviving  AS merchant_merchant_surviving_edges_by_threshold,
        @@mm_connected  AS merchants_with_degree_by_threshold;
}
