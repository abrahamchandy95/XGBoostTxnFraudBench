USE GRAPH TF_GNN

CREATE OR REPLACE QUERY louvain_bipartite(
    STRING build_id,
    INT    min_txn_count = 1,
    INT    max_iteration = 20
) SYNTAX V1 {

  SumAccum<FLOAT> @k;
  SumAccum<INT>   @comm;
  MapAccum<INT, SumAccum<FLOAT>> @k_to;

  MapAccum<INT, SumAccum<FLOAT>> @@comm_tot;
  MapAccum<INT, SumAccum<FLOAT>> @@in2; 
  MapAccum<INT, SumAccum<INT>>   @@sizes, @@size_histogram;

  SumAccum<FLOAT> @@two_m;             
  SumAccum<INT>   @@moved, @@iterations, @@communities;
  SumAccum<INT>   @@cards_unseen, @@merchants_unseen;
  MaxAccum<INT>   @@largest;
  SumAccum<FLOAT> @@modularity;

  SeenC = SELECT c FROM Card:c     WHERE c.seen == TRUE;
  SeenM = SELECT m FROM Merchant:m WHERE m.seen == TRUE;

  dg = SELECT s FROM SeenC:s -(Has_Interaction_With_Merchant:e)- Merchant:t
       WHERE t.seen == TRUE
         AND e.build_id == build_id
         AND e.txn_count >= min_txn_count
       ACCUM s.@k += e.txn_count,
             t.@k += e.txn_count;

  inic = SELECT s FROM SeenC:s
         POST-ACCUM s.@comm = getvid(s), @@two_m += s.@k;
  inim = SELECT s FROM SeenM:s
         POST-ACCUM s.@comm = getvid(s), @@two_m += s.@k;

  @@moved = 1;
  WHILE @@moved > 0 LIMIT max_iteration DO
      @@moved = 0;
      @@iterations += 1;

      @@comm_tot.clear();
      t1c = SELECT s FROM SeenC:s POST-ACCUM @@comm_tot += (s.@comm -> s.@k);
      t1m = SELECT s FROM SeenM:s POST-ACCUM @@comm_tot += (s.@comm -> s.@k);

      nbc = SELECT s FROM SeenC:s -(Has_Interaction_With_Merchant:e)- Merchant:t
            WHERE t.seen == TRUE
              AND e.build_id == build_id
              AND e.txn_count >= min_txn_count
            ACCUM s.@k_to += (t.@comm -> e.txn_count);

      mvc = SELECT s FROM SeenC:s
            POST-ACCUM
              INT best_comm = s.@comm,
              FLOAT best_gain = 0 - 1000000000,
              FOREACH (c, kic) IN s.@k_to DO
                  FLOAT sigma = @@comm_tot.get(c),
                  IF c == s.@comm THEN sigma = sigma - s.@k END,
                  FLOAT gain = kic - (sigma * s.@k) / @@two_m,
                  IF gain > best_gain THEN
                      best_gain = gain, best_comm = c
                  ELSE IF gain == best_gain AND c < best_comm THEN
                      best_comm = c
                  END
              END,
              IF best_comm != s.@comm THEN
                  s.@comm = best_comm, @@moved += 1
              END,
              s.@k_to.clear();

      @@comm_tot.clear();
      t2c = SELECT s FROM SeenC:s POST-ACCUM @@comm_tot += (s.@comm -> s.@k);
      t2m = SELECT s FROM SeenM:s POST-ACCUM @@comm_tot += (s.@comm -> s.@k);

      nbm = SELECT s FROM SeenM:s -(Has_Interaction_With_Merchant:e)- Card:t
            WHERE t.seen == TRUE
              AND e.build_id == build_id
              AND e.txn_count >= min_txn_count
            ACCUM s.@k_to += (t.@comm -> e.txn_count);

      mvm = SELECT s FROM SeenM:s
            POST-ACCUM
              INT best_comm = s.@comm,
              FLOAT best_gain = 0 - 1000000000,
              FOREACH (c, kic) IN s.@k_to DO
                  FLOAT sigma = @@comm_tot.get(c),
                  IF c == s.@comm THEN sigma = sigma - s.@k END,
                  FLOAT gain = kic - (sigma * s.@k) / @@two_m,
                  IF gain > best_gain THEN
                      best_gain = gain, best_comm = c
                  ELSE IF gain == best_gain AND c < best_comm THEN
                      best_comm = c
                  END
              END,
              IF best_comm != s.@comm THEN
                  s.@comm = best_comm, @@moved += 1
              END,
              s.@k_to.clear();
  END;

  szc = SELECT s FROM SeenC:s POST-ACCUM @@sizes += (s.@comm -> 1);
  szm = SELECT s FROM SeenM:s POST-ACCUM @@sizes += (s.@comm -> 1);

  @@comm_tot.clear();
  t3c = SELECT s FROM SeenC:s POST-ACCUM @@comm_tot += (s.@comm -> s.@k);
  t3m = SELECT s FROM SeenM:s POST-ACCUM @@comm_tot += (s.@comm -> s.@k);

  inw = SELECT s FROM SeenC:s -(Has_Interaction_With_Merchant:e)- Merchant:t
        WHERE t.seen == TRUE
          AND e.build_id == build_id
          AND e.txn_count >= min_txn_count
          AND s.@comm == t.@comm
        ACCUM @@in2 += (s.@comm -> (2.0 * e.txn_count));

  wrc = SELECT s FROM SeenC:s
        POST-ACCUM
          INT n = @@sizes.get(s.@comm),
          s.louvain_id = s.@comm,
          s.louvain_size = n,
          @@largest += n;
  wrm = SELECT s FROM SeenM:s
        POST-ACCUM
          INT n = @@sizes.get(s.@comm),
          s.louvain_id = s.@comm,
          s.louvain_size = n,
          @@largest += n;

  unc = SELECT c FROM Card:c WHERE c.seen == FALSE
        POST-ACCUM @@cards_unseen += 1;
  unm = SELECT m FROM Merchant:m WHERE m.seen == FALSE
        POST-ACCUM @@merchants_unseen += 1;

  FOREACH (c, n) IN @@sizes DO
      @@communities += 1;
      @@size_histogram += (n -> 1);
      IF @@two_m > 0 THEN
          FLOAT dC = @@comm_tot.get(c);
          FLOAT lC2 = 0;
          IF @@in2.containsKey(c) THEN lC2 = @@in2.get(c); END;
          @@modularity += (lC2 / @@two_m) - (dC / @@two_m) * (dC / @@two_m);
      END;
  END;

  PRINT @@communities      AS louvain_community_count,
        @@largest          AS largest_community_size,
        @@modularity       AS modularity_Q,
        @@iterations       AS iterations_run,
        max_iteration      AS iteration_limit,
        @@cards_unseen     AS cards_unseen_excluded,
        @@merchants_unseen AS merchants_unseen_excluded,
        min_txn_count      AS min_txn_count_used,
        build_id           AS build_id;

  PRINT @@size_histogram AS louvain_size_histogram;
}
