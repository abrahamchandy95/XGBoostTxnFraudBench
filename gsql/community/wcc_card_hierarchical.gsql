// Alternative to wcc_card

USE GRAPH TF_GNN

CREATE OR REPLACE QUERY wcc_card_hierarchical(
    STRING build_id,
    FLOAT  level_high = 10,
    FLOAT  level_low  = 1,
    INT    n_levels   = 10,
    BOOL   print_results = FALSE
) SYNTAX V1 {

  MinAccum<INT>                @min_cc_id;
  OrAccum                      @in_play;
  MapAccum<INT, SumAccum<INT>> @@comp_sizes, @@size_histogram;
  MapAccum<INT, SumAccum<INT>> @@peeled_at_level;
  MaxAccum<INT>                @@largest_component;
  SumAccum<INT>                @@components, @@cards_in_components, @@cards_unseen;

  FLOAT seg = (level_high - level_low) / n_levels;

  Seen = SELECT c FROM Card:c WHERE c.seen == TRUE;
  S = SELECT c FROM Seen:c POST-ACCUM c.@min_cc_id = getvid(c);

  init_play = SELECT c FROM Seen:c POST-ACCUM c.@in_play = TRUE;
  remaining = Seen;

  FOREACH i IN RANGE[1, n_levels] DO
      FLOAT level = level_high - (i - 1) * seg;

      S = remaining;
      WHILE (S.size() > 0) DO
          S = SELECT t
              FROM S:s -(Card_Card:e)- Card:t
              WHERE t.@in_play == TRUE AND e.weight >= level
              ACCUM t.@min_cc_id += s.@min_cc_id
              HAVING t.@min_cc_id != t.@min_cc_id';
      END;

      /* freeze whatever this level connected, then drop to the next */
      settled = SELECT t
                FROM remaining:s -(Card_Card:e)- Card:t
                WHERE t.@in_play == TRUE AND e.weight >= level;
      @@peeled_at_level += (i -> settled.size());
      /* leaves `remaining` now, so it must stop being a legal
         traversal target at the same moment */
      drop_play = SELECT t FROM settled:t POST-ACCUM t.@in_play = FALSE;
      remaining = remaining MINUS settled;
  END;

  sizes = SELECT c FROM Seen:c POST-ACCUM @@comp_sizes += (c.@min_cc_id -> 1);

  write = SELECT c FROM Seen:c
          POST-ACCUM
            INT sz = @@comp_sizes.get(c.@min_cc_id),
            c.c_id = c.@min_cc_id,
            c.c_size = sz,
            @@largest_component += sz,
            @@cards_in_components += 1,
            INSERT INTO Community (PRIMARY_ID) VALUES (c.@min_cc_id),
            INSERT INTO Has_Community VALUES (c, c.@min_cc_id);

  unseen = SELECT c FROM Card:c WHERE c.seen == FALSE
           POST-ACCUM @@cards_unseen += 1;

  FOREACH (cid, sz) IN @@comp_sizes DO
      @@components += 1;
      @@size_histogram += (sz -> 1);
  END;

  /* peeled_at_level is the diagnostic the kit never printed. If almost
     everything settles at level 1, the grid is too loose and this is
     just flat WCC wearing a hat. If almost nothing settles until the
     last level, level_high is above your maximum edge weight and the
     early passes did nothing. Either way, reset the grid from
     projection_density_check rather than leaving the defaults. */
  PRINT @@components          AS component_count,
        @@cards_in_components AS cards_in_components,
        @@cards_unseen        AS cards_unseen_excluded,
        @@largest_component   AS largest_component_size,
        level_high AS level_high_used, level_low AS level_low_used,
        n_levels AS n_levels_used,
        build_id AS build_id;
  PRINT @@peeled_at_level AS vertices_settled_per_level;
  PRINT @@size_histogram  AS component_size_histogram;

  IF print_results THEN
      Top = SELECT c FROM Seen:c LIMIT 100;
      PRINT Top[Top.c_id, Top.c_size];
  END;
}
