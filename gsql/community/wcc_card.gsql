USE GRAPH TF_GNN

CREATE OR REPLACE QUERY wcc_card(
    STRING build_id,
    FLOAT  min_weight = 0,
    BOOL   print_results = FALSE,
    INT    print_limit = 100
) SYNTAX V1 {

  MinAccum<INT>                @min_cc_id;
  SumAccum<INT>                @cc_deg;
  MapAccum<INT, SumAccum<INT>> @@comp_sizes;
  MapAccum<INT, SumAccum<INT>> @@size_histogram;
  MaxAccum<INT>                @@largest_component;
  SumAccum<INT>                @@components, @@cards_in_components;
  SumAccum<INT>                @@cards_isolated, @@cards_unseen;

  Seen = SELECT c FROM Card:c WHERE c.seen == TRUE;

  dg = SELECT s FROM Seen:s -(Card_Card:e)- Card:t
       WHERE t.seen == TRUE AND e.weight >= min_weight
       ACCUM s.@cc_deg += 1;

  Active = SELECT c FROM Seen:c WHERE c.@cc_deg > 0
           POST-ACCUM
             c.build_id = build_id,
             c.cc_degree = c.@cc_deg,
             c.@min_cc_id = getvid(c);

  iso = SELECT c FROM Seen:c WHERE c.@cc_deg == 0
        POST-ACCUM
          c.build_id = build_id,
          c.cc_degree = 0,
          @@cards_isolated += 1;

  S = Active;
  WHILE (S.size() > 0) DO

      S = SELECT t
          FROM S:s -(Card_Card:e)- Card:t
          WHERE t.seen == TRUE AND t.@cc_deg > 0
            AND e.weight >= min_weight
          ACCUM t.@min_cc_id += s.@min_cc_id
          HAVING t.@min_cc_id != t.@min_cc_id';
  END;

  sizes = SELECT c FROM Active:c
          POST-ACCUM @@comp_sizes += (c.@min_cc_id -> 1);

  write = SELECT c FROM Active:c
          POST-ACCUM
            INT sz = @@comp_sizes.get(c.@min_cc_id),
            c.c_id = c.@min_cc_id,
            c.c_size = sz,
            @@largest_component += sz,
            @@cards_in_components += 1,
            INSERT INTO Community (PRIMARY_ID, build_id)
              VALUES (c.@min_cc_id, build_id),
            INSERT INTO Has_Community VALUES (c, c.@min_cc_id);

  unseen = SELECT c FROM Card:c WHERE c.seen == FALSE
           POST-ACCUM @@cards_unseen += 1;

  FOREACH (cid, sz) IN @@comp_sizes DO
      @@components += 1;
      @@size_histogram += (sz -> 1);
  END;

  PRINT @@components          AS component_count,
        @@cards_in_components AS cards_in_components,
        @@cards_isolated      AS cards_isolated_in_projection,
        @@cards_unseen        AS cards_unseen_excluded,
        @@largest_component   AS largest_component_size,
        min_weight            AS min_weight_used,
        build_id              AS build_id;

  PRINT @@size_histogram AS component_size_histogram_MUST_HAVE_NO_KEY_1;

  IF print_results THEN
      Top = SELECT c FROM Active:c LIMIT print_limit;
      PRINT Top[Top.c_id, Top.c_size, Top.cc_degree];
  END;
}
